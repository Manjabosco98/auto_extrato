GOOGLE_APPLICATION_CREDENTIALS=credentials/api-service-account.json
GOOGLE_DRIVE_FOLDER_ID=your_google_drive_srvarq_folder_id
GOOGLE_DRIVE_EMP_FOLDER_ID=your_google_drive_emp_folder_id

FOLDER_MIME_TYPE="application/vnd.google-apps.folder"
PDF_MIME_TYPE="application/pdf"
XLSX_MIME_TYPE="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
XLSM_MIME_TYPE="application/vnd.ms-excel.sheet.macroenabled.12"
XLS_MIME_TYPE="application/vnd.ms-excel"

# OPENAI (fallback de leitura para extratos ilegiveis / layout nao reconhecido)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-5-mini
# Paginas por chamada a IA (PDFs maiores sao divididos em lotes)
IA_PAGINAS_POR_LOTE=4
# Limite de tokens de saida por chamada (respostas truncadas sao redivididas)
IA_MAX_OUTPUT_TOKENS=65536

# SUPABASE
SUPABASE_BASE_URL=https://your-project.supabase.co/functions/v1/api-documentos
SUPABASE_CONTROLE_KEY=your_supabase_key_here
SUPABASE_EMPRESAS_URL=https://your-project.supabase.co/functions/v1/api-documentos/empresas

# WHATSAPP
EVOLUTION_BASE_URL=https://your-evolution-api.onrender.com/
EVOLUTION_API_KEY=your_evolution_api_key_here
EVOLUTION_INSTANCE_NAME=ExtractPDFs
WEBHOOK_API_WHATSAPP=https://your-webhook-url.com

# DIGITALOCEAN
DIGITALOCEAN_API_TOKEN=your_digitalocean_token_here
